# Lingxi local configuration.
# Copy this file to `.env` before starting. Never commit `.env`.
# Do not put a real upstream key in this example file.

# HTTP server
PORT=8787
LINGXI_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# sqlite (default, zero extra services):
DATABASE_URL=file:./data/lingxi.sqlite
# Postgres path (see README). Example only — set your own password:
# DATABASE_URL=postgres://lingxi:change-me@localhost:5432/lingxi

# Upstream OpenAI-compatible API. Leave the key empty to boot in mock mode.
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
UPSTREAM_TIMEOUT_MS=120000
# Set to true to force the built-in mock even when UPSTREAM_API_KEY is set.
UPSTREAM_MOCK=false

# Admin API bearer token. Change this before any shared or production use.
ADMIN_TOKEN=dev-admin-token-change-me

# Comma-separated browser origins, or * for local development.
# Leave empty to disable CORS.
CORS_ORIGINS=*

# Abuse controls
MAX_BODY_BYTES=1048576
MAX_MESSAGES=200
MAX_COMPLETION_TOKENS=32768
AUTH_FAIL_LIMIT=30
TRUST_PROXY=false

# Optional pepper mixed into customer API key hashes.
KEY_HASH_PEPPER=

# Model catalog. Public ids are what customers send; `upstream` is forwarded.
MODEL_CONFIG_PATH=./config/models.json
# When false, unknown model ids are rejected.
ALLOW_PASSTHROUGH_MODELS=false
DEFAULT_INPUT_MICROS_PER_MILLION=1000000
DEFAULT_OUTPUT_MICROS_PER_MILLION=4000000

# Optional HMAC payment webhook. Empty disables POST /admin/payments/webhook.
PAYMENT_WEBHOOK_SECRET=

# Delete usage events older than N days on startup. 0 keeps everything.
USAGE_RETENTION_DAYS=0

# Maximum characters injected from selected skill packs into one chat request.
SKILL_INJECT_MAX_CHARS=12000
